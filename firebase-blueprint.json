{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with RBAC role, account status, and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "role", "status"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Individual reflective journal document with optional geotag and AI response",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mode": { "type": "string" },
        "aiResponse": { "type": "string" },
        "modelUsed": { "type": "string" },
        "tags": { "type": "array" },
        "mood": { "type": "string" },
        "location": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Security and administrative audit trail for role changes and policy updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetEmail": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorUid", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document storing profile and RBAC role"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User journal entries with owner-bound access and admin oversight"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Immutable security audit logs for sensitive administrative actions"
    }
  }
}
