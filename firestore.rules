rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and ownership helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).role in ['admin', 'superadmin']) ||
        (request.auth.token.email != null && request.auth.token.email == 'krishnaraddi@gmail.com')
      );
    }

    // User profile and RBAC rules
    match /users/{userId} {
      // User can read their own profile; admins can read all user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can initialize their own profile document
      allow create: if isOwner(userId);

      // Updating profile:
      // Owners can update their profile as long as they do not escalate their own role
      // Admins can update any user profile, including role and status changes
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();

      // Only admins can delete user profile documents
      allow delete: if isAdmin();

      // User's journal entries
      match /entries/{entryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User's interaction logs
      match /interactions/{interactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin audit logs - strictly restricted to administrators
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // Platform metrics summary
    match /system_metrics/{metricId} {
      allow read, write: if isAdmin();
    }
  }
}

